# Variaveis do ambiente local (ADR_151). Copie para .env nesta pasta (infra/local/.env).
# O .env e obrigatorio: as senhas do MongoDB, do Redis, do OpenObserve e do Grafana nao tem valor padrao
# no compose, que para com erro se faltarem (FR-026). Os valores "change-me" abaixo sao so placeholders:
# troque TODOS no seu .env antes de subir. Os demais valores sao os padroes do compose.
# Somente desenvolvimento: nao use em producao. Nunca versione o .env nem coloque segredo real aqui.

# MongoDB. Senhas: troque o placeholder no seu .env local (nao versionado).
# MONGO_APP_PASSWORD so vale na primeira subida (volume vazio); depois, troque com
# "docker compose -f infra/local/compose.yaml down -v" (apaga os dados locais).
MONGO_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me
MONGO_APP_DATABASE=lhamalog_collector
MONGO_APP_USERNAME=lhamalog
MONGO_APP_PASSWORD=change-me

# Redis (fila de mensagens da Varredura: o collector publica uma referencia por lote aceito, gravado no
# OpenObserve, em lhamalog:stream:logs e lhamalog:stream:traces).
# Senha obrigatoria no compose principal: defina so no .env, nunca com valor real neste exemplo.
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# OpenObserve (destino de logs e traces do receptor OTLP - ADR_168, LLT-181)
# Usuario deve ser um e-mail; senha com 8-128 caracteres, minuscula, maiuscula, digito e caractere especial.
# O compose usa o mesmo par como usuario root do OpenObserve local.
OPENOBSERVE_PORT=5080
OPENOBSERVE_URL=http://localhost:5080
OPENOBSERVE_ORGANIZATION=lhamalog
OPENOBSERVE_LOGS_STREAM=logs
OPENOBSERVE_TRACES_STREAM=traces
OPENOBSERVE_USERNAME=admin@example.com
OPENOBSERVE_PASSWORD=Change-me-123!
# Logs da plataforma (Alloy, LLT-187): base64 de "email:passcode de ingestao" do OpenObserve. Os dois formatos funcionam:
# "<base64>" ou "Basic <base64>" (o Alloy remove o prefixo, sem diferenciar maiusculas, e apara espacos).
# Destino fixo: org default, stream lhamalog_platform. Preencha no .env local; nunca versione o valor.
OPENOBSERVE_AUTH_BASIC=

# OpenTelemetry Collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# A aplicacao precisa do mesmo usuario/senha da aplicacao no MongoDB, por exemplo (PowerShell):
#   $env:MONGODB_URI="mongodb://<usuario>:<senha>@localhost:27017/lhamalog_collector?authSource=lhamalog_collector"

# Mensageria Redis Streams (LLT-184): retry interno e DLQ na publicacao. Padroes da aplicacao;
# descomente no seu .env local so se precisar sobrescrever (nao editar o .env versionado via PR).
# LHAMALOG_MESSAGING_STREAM_LOGS_MAX_LEN=100000
# LHAMALOG_MESSAGING_STREAM_TRACES_MAX_LEN=100000
# LHAMALOG_MESSAGING_STREAM_LOGS_DLQ_MAX_LEN=100000
# LHAMALOG_MESSAGING_STREAM_TRACES_DLQ_MAX_LEN=100000
# LHAMALOG_MESSAGING_PUBLISH_MAX_ATTEMPTS=3
# LHAMALOG_MESSAGING_PUBLISH_BACKOFF_INITIAL_MS=100
# LHAMALOG_MESSAGING_PUBLISH_BACKOFF_MULTIPLIER=2
# LHAMALOG_MESSAGING_PUBLISH_BACKOFF_CEILING_MS=2000

# Sincronizacao de fatos de uso com o Core (LLT-186). O valor do token e secreto:
# preencha somente no .env local ignorado, nunca neste exemplo.
LHAMALOG_USAGE_ENABLED=false
LHAMALOG_USAGE_CORE_URL=http://localhost:8081
LHAMALOG_COLLECTOR_CORE_TOKEN=change-me

# --- Observabilidade do Collector (LLT-187 / compose.observability.yaml) ---
# Nao precisa dos secrets acima. Porta de scrape do Collector (management):
MANAGEMENT_PORT=9464
# Interface da porta de management (default 127.0.0.1 em todos os perfis). Use 0.0.0.0 so se o Prometheus
# nao alcancar o host (ex.: Docker em Linux sem host-gateway), nunca em rede compartilhada.
# MANAGEMENT_ADDRESS=127.0.0.1
# Arquivo de log tailed pelo Alloy (relativo ao repo):
LHAMALOG_LOG_FILE=logs/lhamalog-collector.log
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Obrigatoria no compose.observability.yaml (sem acesso anonimo). Placeholder: troque no .env.
GRAFANA_ADMIN_PASSWORD=change-me
