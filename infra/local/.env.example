# Variaveis do ambiente local (ADR_151). Copie para .env nesta pasta (infra/local/.env).
# O .env e obrigatorio: as senhas do MongoDB e o usuario/senha do OpenObserve nao tem valor padrao e o
# compose para com erro se faltarem (FR-026). Os demais valores abaixo sao os padroes do compose.
# Somente desenvolvimento: nao use em producao. Nunca versione o .env.

# MongoDB. As senhas nao tem valor aqui: preencha no seu .env local (nao versionado).
# MONGO_APP_PASSWORD so vale na primeira subida (volume vazio); depois, troque com
# "docker compose -f infra/local/compose.yaml down -v" (apaga os dados locais).
MONGO_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_DATABASE=lhamalog_collector
MONGO_APP_USERNAME=lhamalog
MONGO_APP_PASSWORD=

# Redis (fila de mensagens da Varredura: o collector publica cada log aceito em lhamalog:stream:logs).
# Senha obrigatoria: o compose para com erro se ficar vazia. Defina so no .env, nunca aqui.
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenObserve (destino de logs e traces do receptor OTLP - ADR_168, LLT-181)
# Usuario e senha nao tem valor aqui: preencha no seu .env local (nao versionado).
# Usuario deve ser um e-mail; senha com 8-128 caracteres, minuscula, maiuscula, digito e caractere especial.
# O compose usa o mesmo par como usuario root do OpenObserve local.
OPENOBSERVE_PORT=5080
OPENOBSERVE_URL=http://localhost:5080
OPENOBSERVE_ORGANIZATION=lhamalog
OPENOBSERVE_LOGS_STREAM=logs
OPENOBSERVE_TRACES_STREAM=traces
OPENOBSERVE_USERNAME=
OPENOBSERVE_PASSWORD=

# OpenTelemetry Collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# A aplicacao precisa do mesmo usuario/senha da aplicacao no MongoDB, por exemplo (PowerShell):
#   $env:MONGODB_URI="mongodb://<usuario>:<senha>@localhost:27017/lhamalog_collector?authSource=lhamalog_collector"
