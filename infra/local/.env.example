# Variaveis do ambiente local (ADR_151). Copie para .env nesta pasta (infra/local/.env).
# Sem .env, o compose usa exatamente estes valores padrao. Somente desenvolvimento: nao use em producao.

# MongoDB
MONGO_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root
MONGO_APP_DATABASE=lhamalog_collector
MONGO_APP_USERNAME=lhamalog
MONGO_APP_PASSWORD=lhamalog

# Redis
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m

# OpenTelemetry Collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# Se mudar portas ou credenciais acima, ajuste tambem a aplicacao, por exemplo (PowerShell):
#   $env:MONGODB_URI="mongodb://lhamalog:lhamalog@localhost:27017/lhamalog_collector?authSource=lhamalog_collector"
