      "title": "Collector logs (filter by cid)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 47 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=\"lhamalog-collector\"} |= \"$cid\" |~ \"$level\"",
          "legendFormat": ""
        }
      ]
    }
