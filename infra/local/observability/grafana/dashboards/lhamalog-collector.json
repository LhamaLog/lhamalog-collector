          "legendFormat": "{{id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM GC pause",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[5m])",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM threads",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "jvm_threads_live_threads", "legendFormat": "live" },
        { "expr": "jvm_threads_peak_threads", "legendFormat": "peak" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process CPU",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 40 },
