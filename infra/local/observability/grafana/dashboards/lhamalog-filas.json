        "name": "signal",
        "label": "Signal",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(lhamalog_queue_size, signal)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(lhamalog_queue_size, signal)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "regex": "",
        "allValue": ".*",
