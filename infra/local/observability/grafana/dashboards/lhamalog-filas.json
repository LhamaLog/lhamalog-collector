    {
      "id": 9,
      "type": "timeseries",
      "title": "Taxa de entrada x saída",
      "description": "Entrada = lotes aceitos por segundo (1 mensagem por lote). Saída estimada = entrada menos o crescimento da stream; na stream Redis isso é a remoção por MAXLEN/XDEL. O consumo real (lag do grupo da Varredura) depende de métricas da Varredura, ainda não expostas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (signal) (rate(lhamalog_ingestion_latency_seconds_count{outcome=~\"accepted|partial\", signal=~\"$signal\"}[$__rate_interval]))",
          "legendFormat": "entrada {{signal}}",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(sum by (signal) (rate(lhamalog_ingestion_latency_seconds_count{outcome=~\"accepted|partial\", signal=~\"$signal\"}[$__rate_interval])) - sum by (signal) (deriv(lhamalog_queue_size{signal=~\"$signal\"}[5m])), 0)",
          "legendFormat": "saída estimada {{signal}}",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "sem dados",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "off"
            }
